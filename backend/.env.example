# ===================================================
# RoomSync Backend Environment Configuration
# Copy this file to .env and configure your keys.
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/roomsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/roomsync

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Media Storage (Cloudinary - for verified room photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Geocoding & Maps (Google Maps Platform)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Payment Gateway (Razorpay - TEST MODE ONLY)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email Service (Gmail SMTP via Nodemailer - Password Recovery & Verification)
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=RoomSync <your_sender_gmail@gmail.com>
FRONTEND_URL=http://localhost:5173

# Rate Limiter (Optional - controls development request windows)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
